{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wicka-assistance",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-15",
  "vars": {
    "BREVO_COMPANY_EMAIL": "wickaassistance@gmail.com"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
